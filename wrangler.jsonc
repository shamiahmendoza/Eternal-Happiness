{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eternal-happiness2026-svc",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"],
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "eternalhappiness",
    },
  ],
  "d1_databases": [
    {
      "binding": "eternalhappiness_db",
      "database_name": "eternalhappiness-db",
      "database_id": "6f87f305-9382-4615-94a2-b44cb8e2842f",
      "remote": true,
    },
  ],
}
